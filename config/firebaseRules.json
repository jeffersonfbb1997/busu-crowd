{
  "rules": {
    ".read": true,
    "_timeCheck": {
      "$timestamp": {
        ".write": "auth != null",
        ".read": "auth != null"
      }
    },
    "onibus": {
      ".write": "auth.token.email == 'jeffersonfbb1997@gmail.com' || root.child('config/admins').child(auth.uid).exists()",
      "$linha": {
        "$usuario": {
          ".write": "auth != null && (auth.uid == $usuario || auth.token.email == 'jeffersonfbb1997@gmail.com' || root.child('config/admins').child(auth.uid).exists())"
        }
      }
    },
    "config": {
      "admins": {
        ".write": "auth.token.email == 'jeffersonfbb1997@gmail.com'",
        ".read": "auth != null"
      },
      "linhas": {
        ".write": "auth.token.email == 'jeffersonfbb1997@gmail.com' || root.child('config/admins').child(auth.uid).exists()"
      },
      "parametros": {
        ".write": "auth.token.email == 'jeffersonfbb1997@gmail.com' || root.child('config/admins').child(auth.uid).exists()"
      }
    }
  }
}