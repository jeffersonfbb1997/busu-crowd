{
  "name": "busu-crowd",
  "version": "1.0.0",
  "description": "BusU-Crowd - Sistema de monitoramento de ônibus",
  "scripts": {
    "build": "esbuild core/app.js --bundle --outfile=dist/bundle.js --format=esm --target=es2020 --minify",
    "dev": "esbuild core/app.js --bundle --outfile=dist/bundle.js --format=esm --target=es2020 --sourcemap",
    "watch": "esbuild core/app.js --bundle --outfile=dist/bundle.js --format=esm --target=es2020 --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
